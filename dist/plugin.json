{
  "name": "holocron-vr",
  "displayName": "Holocron VR",
  "description": "Explore your codebase as an immersive 3D VR constellation powered by Graphify knowledge graphs.",
  "version": "0.5.1",
  "author": "Yoda-Man",
  "minYodaManVersion": "1.0.0",
  "mandatory": false,
  "entry": "main.js",
  "permissions": [
    "graphify:read",
    "agent:invoke",
    "audit:write",
    "task:create",
    "desktop:openFile",
    "storage:indexeddb",
    "webxr",
    "speech",
    "git:read",
    "upload:temp",
    "filesystem:read-selected"
  ],
  "uiExtensions": [
    {
      "target": "main-tab-bar",
      "position": 1,
      "label": "Agent",
      "icon": "assets/chat-icon.svg",
      "component": "frontend/AgenticChat.js"
    },
    {
      "target": "plugins-tab",
      "label": "Holocron VR",
      "icon": "assets/icon.svg",
      "component": "frontend/UIPanel.js"
    }
  ],
  "configSchema": {
    "lodNear": {
      "type": "number",
      "default": 5,
      "description": "Distance (units) for full-detail LOD tier"
    },
    "lodMid": {
      "type": "number",
      "default": 15,
      "description": "Distance (units) for simplified LOD tier"
    },
    "lodFar": {
      "type": "number",
      "default": 30,
      "description": "Distance (units) for dot-only LOD tier"
    },
    "maxNodes": {
      "type": "number",
      "default": 3000,
      "description": "Maximum nodes to render; warns above this value"
    },
    "voiceEnabled": {
      "type": "boolean",
      "default": true
    }
  }
}

.reasonix/
*.zip

# Dependencies. 7,586 files under node_modules were tracked, so every
# `npm install` produced thousands of diffs and a clean reinstall showed up as
# 2,346 changed files — enough noise to hide a real change completely.
node_modules/

# Build output. dist/ is deliberately NOT ignored: the plugin ships built, and
# dist/plugin.json is read by YodaMan's plugin loader.
coverage/

# Compiled WASM. Regenerated by `npm run build:wasm`, which CI runs on every
# push. Tracking build output is what let the C++ source rot: the binary in the
# tree stayed valid while the source stopped compiling.
frontend/layout_engine.mjs
frontend/layout_engine.wasm
frontend/layout_engine_debug.mjs
